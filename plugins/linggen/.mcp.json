{
  "mcpServers": {
    "linggen": {
      "type": "http",
      "url": "http://${LINGGEN_HOST:-127.0.0.1}:${LINGGEN_PORT:-9527}/mcp",
      "headersHelper": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/mem-headers.sh\""
    },
    "ling-mem": {
      "type": "http",
      "url": "http://${LING_MEM_HOST:-127.0.0.1}:${LING_MEM_PORT:-9528}/mcp",
      "headers": {
        "x-linggen-device": "${LING_MEM_TOKEN:-}"
      },
      "headersHelper": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/mem-headers.sh\""
    }
  }
}
